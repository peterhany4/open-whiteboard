{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "sourceMap": false,
    "rootDir": "./electron",
    "outDir": "./dist-electron",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["electron/**/*"]
}
