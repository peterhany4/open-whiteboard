{
  "name": "whiteboard-rea",
  "private": true,
  "version": "0.1.0",
  "description": "Microsoft Whiteboard REA Desktop Application",
  "author": "Microsoft Whiteboard REA",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.js",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
